# OnAirMulTiMedia - .gitignore
# © 2025 Raymond Demitrio Dr. Tel

# ===================================
# Operating System Files
# ===================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ===================================
# IDE / Editor
# ===================================
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ===================================
# Node.js / JavaScript
# ===================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.npm
.eslintcache
.node_repl_history
dist/
build/
.next/
out/
.nuxt/
.cache/

# ===================================
# Python
# ===================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ===================================
# Rust / Cargo
# ===================================
target/
Cargo.lock
**/*.rs.bk
*.pdb

# ===================================
# Environment & Secrets
# ===================================
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.pfx
secrets.json
config.private.json

# ===================================
# Logs & Databases
# ===================================
*.log
logs/
*.sql
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# ===================================
# Audio / RF / SDR Files
# ===================================
*.wav
*.mp3
*.ogg
*.flac
recordings/
captures/
*.iq
*.raw
*.cfile

# ===================================
# Temporary & Build
# ===================================
tmp/
temp/
*.tmp
*.bak
*.swp
*.old
*.orig
.backup/

# ===================================
# Documentation Build
# ===================================
docs/_build/
site/

# ===================================
# Testing
# ===================================
coverage/
*.cover
.hypothesis/

# ===================================
# Audit System (Keep Structure, Ignore Logs)
# ===================================
audit/logs/*.log
audit/events/*.json
!audit/logs/.gitkeep
!audit/events/.gitkeep

# ===================================
# SDR / Hardware Specific
# ===================================
*.sdr
hardware/configs/local/
calibration/user/

# ===================================
# Docker
# ===================================
docker-compose.override.yml
.dockerignore

# ===================================
# macOS
# ===================================
.AppleDouble
.LSOverride

# ===================================
# Windows
# ===================================
*.lnk
*.stackdump

# ===================================
# Linux
# ===================================
*.core

# Keep empty directories
!**/.gitkeep
