#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-commit hook
echo "🔍 Running pre-commit checks..."

# Run linting
echo "📝 Running ESLint..."
npm run lint:check

# Run formatting check
echo "🎨 Checking code formatting..."
npm run format:check

# Run tests
echo "🧪 Running tests..."
npm run test

echo "✅ Pre-commit checks passed!"
