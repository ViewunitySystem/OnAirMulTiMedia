{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DR Trigger Parameters",
  "description": "Schema für Disaster-Recovery Trigger-Parameter",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "targetRegion": {
      "type": "string",
      "description": "Zielregion / target region code (z.B. eu-central-1, us-east-1)",
      "pattern": "^[a-z0-9-]+$",
      "examples": ["eu-central-1", "us-east-1", "ap-southeast-1"]
    },
    "restorePoint": {
      "type": "string",
      "description": "UTC timestamp or label (e.g., latest, 2025-10-04T12:00:00Z)",
      "pattern": "^(latest|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)$",
      "examples": ["latest", "2025-10-04T12:00:00Z"]
    },
    "hostType": {
      "type": "string",
      "enum": ["original", "alternate"],
      "description": "Original vs Alternate hosts",
      "default": "alternate"
    },
    "restoreMode": {
      "type": "string",
      "enum": ["full", "selective", "promote"],
      "description": "Art des Restores",
      "default": "full"
    },
    "configSource": {
      "type": "string",
      "enum": ["original", "alternate"],
      "description": "Konfigurationsquelle",
      "default": "original"
    },
    "complianceProfile": {
      "type": "string",
      "enum": ["EU-Strict", "US-Strict", "Global-Standard"],
      "description": "Policy/Retention set",
      "default": "EU-Strict"
    },
    "allowReplace": {
      "type": "boolean",
      "default": false,
      "description": "Erlaube destruktive Ersetzung wenn nötig"
    },
    "dnsCutoverTTL": {
      "type": "integer",
      "minimum": 10,
      "maximum": 600,
      "default": 60,
      "description": "TTL Sekunden für Failover"
    },
    "pitrWindowDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "default": 14,
      "description": "PITR Fenster in Tagen"
    },
    "sdrStartMode": {
      "type": "string",
      "enum": ["rx-only", "full"],
      "default": "rx-only",
      "description": "TX nur nach Policy-Re-Validierung"
    },
    "incidentId": {
      "type": "string",
      "description": "Eindeutige Incident-ID für Tracking",
      "pattern": "^INC-[0-9]{8}-[A-Z0-9]{6}$",
      "examples": ["INC-20251004-A1B2C3"]
    },
    "approvalTokens": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dual-Control Approval Tokens",
      "minItems": 2,
      "maxItems": 3
    },
    "evidenceRetentionDays": {
      "type": "integer",
      "minimum": 30,
      "maximum": 2555,
      "default": 365,
      "description": "Aufbewahrungsfrist für Audit-Evidenz in Tagen"
    },
    "txPolicyValidation": {
      "type": "boolean",
      "default": true,
      "description": "SDR TX-Policy Validierung aktivieren"
    },
    "wormArchiveRequired": {
      "type": "boolean",
      "default": true,
      "description": "WORM-Archivierung für Audit-Evidenz erforderlich"
    }
  },
  "required": [
    "targetRegion",
    "restorePoint",
    "hostType",
    "restoreMode",
    "configSource",
    "complianceProfile",
    "incidentId",
    "approvalTokens"
  ],
  "if": {
    "properties": {
      "complianceProfile": {
        "const": "EU-Strict"
      }
    }
  },
  "then": {
    "properties": {
      "evidenceRetentionDays": {
        "maximum": 1095,
        "description": "EU-DSGVO konforme Aufbewahrungsfrist (max. 3 Jahre)"
      },
      "wormArchiveRequired": {
        "const": true,
        "description": "WORM-Archivierung bei EU-Strict zwingend"
      }
    }
  }
}
