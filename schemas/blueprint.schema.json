{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OnAir MultiMedia Blueprint Schema",
  "description": "Schema für OnAir MultiMedia System Blueprints",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Eindeutige ID des Blueprints"
    },
    "name": {
      "type": "string",
      "description": "Name des Blueprints"
    },
    "version": {
      "type": "string",
      "description": "Version des Blueprints"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung des Blueprints"
    },
    "type": {
      "type": "string",
      "enum": ["meeting", "presentation", "streaming", "collaboration"],
      "description": "Typ des Blueprints"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "config": { "type": "object" }
        },
        "required": ["id", "type"]
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "autoStart": { "type": "boolean" },
        "recording": { "type": "boolean" },
        "quality": { "type": "string", "enum": ["low", "medium", "high", "ultra"] }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["id", "name", "version", "type", "components"]
}