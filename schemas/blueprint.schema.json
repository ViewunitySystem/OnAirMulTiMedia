{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OnAirMulTiMedia Blueprint Schema",
  "description": "Schema für Blueprint-Module der OnAirMulTiMedia Plattform",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Eindeutige ID des Blueprints"
    },
    "name": {
      "type": "string",
      "description": "Name des Blueprints"
    },
    "version": {
      "type": "string",
      "description": "Version des Blueprints"
    },
    "description": {
      "type": "string",
      "description": "Beschreibung des Blueprints"
    },
    "category": {
      "type": "string",
      "enum": ["Haupt-Apps", "Blueprint-Module", "Discovery-Engines", "Self-Healing-Regeln"],
      "description": "Kategorie des Blueprints"
    },
    "status": {
      "type": "string",
      "enum": ["operational", "degraded", "maintenance", "error"],
      "description": "Aktueller Status"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liste der Features"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Abhängigkeiten zu anderen Modulen"
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "DELETE"]
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "API-Endpoints des Blueprints"
    },
    "deployment": {
      "type": "object",
      "properties": {
        "githubPages": {
          "type": "boolean"
        },
        "firebaseProd": {
          "type": "boolean"
        },
        "firebaseStaging": {
          "type": "boolean"
        },
        "firebaseDev": {
          "type": "boolean"
        }
      },
      "description": "Deployment-Konfiguration"
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "healthCheck": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Monitoring-Konfiguration"
    }
  },
  "required": ["id", "name", "version", "description", "category", "status"],
  "additionalProperties": false
}