{
  "name": "onairmultimedia",
  "version": "2.0.0",
  "description": "OnAirMulTiMedia - Self-Healing Multi-Target Deployment Platform",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.ts,.tsx,.html",
    "lint:fix": "eslint . --ext .js,.ts,.tsx,.html --fix",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "selfheal": "tsx scripts/selfheal.ts",
    "selfheal:config": "tsx scripts/selfheal.ts --config-only",
    "duplication": "jscpd --min-lines 5 --min-tokens 50 --reporters json,html --output jscpd-report",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "security": "npm audit && cargo audit",
    "firebase:deploy": "firebase deploy",
    "firebase:deploy:prod": "firebase deploy --only hosting:onairmultimedia",
    "firebase:deploy:staging": "firebase deploy --only hosting:onairmultimedia-staging",
    "firebase:deploy:dev": "firebase deploy --only hosting:onairmultimedia-dev",
    "firebase:preview": "firebase hosting:channel:deploy preview --expires 7d",
    "pages:deploy": "gh-pages -d .",
    "clean": "rm -rf dist node_modules/.vite .selfheal-*.json jscpd-report selfheal-reports",
    "setup": "npm install && npx playwright install --with-deps",
    "ci": "npm run lint && npm run test && npm run selfheal",
    "ci:full": "npm run ci && npm run duplication && npm run security",
    "discovery:scan": "node tools/discovery/scan.js --root modules --out audit/events/discovery.jsonl",
    "manifest:build": "node tools/manifest/build.js > manifest.json",
    "manifest:validate": "node tools/manifest/validate.js manifest.json",
    "manifest:sign": "node tools/manifest/sign.js manifest.json > manifest.sig",
    "license:pulse": "node modules/LicensePulse/pulse.js --export audit/exports/license-$(date +%F).json",
    "recovery:beacon": "node tools/recovery/beacon.js"
  },
  "keywords": [
    "self-healing",
    "multi-target-deployment",
    "github-pages",
    "firebase-hosting",
    "webtrit-swipe",
    "auditierbar",
    "onairmultimedia"
  ],
  "author": "Raymond Demitrio Dr. Tel",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "cheerio": "^1.0.0-rc.12",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "firebase-tools": "^13.0.0",
    "gh-pages": "^6.1.0",
    "globby": "^14.0.0",
    "jscpd": "^3.5.0",
    "prettier": "^3.1.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "firebase": "^10.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ViewunitySystem/OnAirMulTiMedia.git"
  },
  "bugs": {
    "url": "https://github.com/ViewunitySystem/OnAirMulTiMedia/issues"
  },
  "homepage": "https://viewunitysystem.github.io/OnAirMulTiMedia/"
}