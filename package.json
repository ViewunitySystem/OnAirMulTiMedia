{
  "name": "onairmultimedia",
  "version": "2.0.0",
  "description": "OnAirMulTiMedia - Self-Healing Multi-Target Deployment Platform",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.ts,.tsx,.html",
    "lint:fix": "eslint . --ext .js,.ts,.tsx,.html --fix",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:110": "vitest run --coverage --reporter=verbose",
    "test:coverage:report": "vitest run --coverage && open coverage/index.html",
    "test:unit": "vitest run --dir tests/services tests/api",
    "test:integration": "vitest run --dir tests/integration",
    "test:performance": "vitest run --dir tests/performance",
    "test:load": "vitest run --dir tests/performance/load-tests.test.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:performance",
    "test:110": "npm run test:coverage:110 && npm run test:all",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:404": "playwright test -g '404'",
    "test:offline": "playwright test -g 'Offline'",
    "test:404-offline": "playwright test -g '404' -g 'Offline'",
    "selfheal": "tsx scripts/selfheal.ts",
    "selfheal:config": "tsx scripts/selfheal.ts --config-only",
    "heal": "npm run selfheal",
    "audit:urls": "node scripts/url-healthcheck.mjs",
    "monitor:continuous": "node scripts/continuous-monitor.mjs",
    "monitor:followup": "node scripts/followup-error-detection.mjs",
    "monitor:all": "npm run monitor:continuous && npm run monitor:followup",
    "fix:navigation": "node scripts/fix-navigation-flow.mjs",
    "fix:errors": "node scripts/comprehensive-error-fix.mjs",
    "fix:root-domain": "node scripts/fix-github-pages-root-domain.mjs",
    "audit:deep": "node scripts/deep-audit-system.mjs",
    "audit:maximize": "node scripts/maximize-audit-system.mjs",
    "predeploy:pages": "npm run heal && npm run audit:urls && npm run monitor:all && npm run fix:navigation && npm run fix:errors && npm run fix:root-domain && npm run audit:maximize",
    "deploy:pages": "npm run predeploy:pages",
    "duplication": "jscpd --min-lines 5 --min-tokens 50 --reporters json,html --output jscpd-report",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "security": "npm audit && cargo audit",
    "firebase:deploy": "firebase deploy",
    "firebase:deploy:prod": "firebase deploy --only hosting:onairmultimedia",
    "firebase:deploy:staging": "firebase deploy --only hosting:onairmultimedia-staging",
    "firebase:deploy:dev": "firebase deploy --only hosting:onairmultimedia-dev",
    "firebase:preview": "firebase hosting:channel:deploy preview --expires 7d",
    "pages:deploy": "gh-pages -d .",
    "clean": "rm -rf dist node_modules/.vite .selfheal-*.json jscpd-report selfheal-reports",
    "setup": "npm install && npx playwright install --with-deps",
    "ci": "npm run lint && npm run test && npm run selfheal",
    "ci:full": "npm run ci && npm run duplication && npm run security",
    "ci:110": "npm run lint && npm run test:110 && npm run selfheal && npm run duplication && npm run security",
    "ci:coverage": "npm run test:coverage:110 && npm run lint && npm run selfheal",
    "discovery:scan": "node tools/discovery/scan.js --root modules --out audit/events/discovery.jsonl",
    "manifest:build": "node tools/manifest/build.js > manifest.json",
    "manifest:validate": "node tools/manifest/validate.js manifest.json",
    "manifest:sign": "node tools/manifest/sign.js manifest.json > manifest.sig",
    "license:pulse": "node modules/LicensePulse/pulse.js --export audit/exports/license-$(date +%F).json",
    "recovery:beacon": "node tools/recovery/beacon.js",
    "hfrf:test": "npm run test:hfrf:audit && npm run test:hfrf:usb && npm run test:hfrf:sdr",
    "test:hfrf:audit": "node -e \"const service = require('./src/services/enhanced-audit-service'); console.log('✅ Enhanced Audit Service test passed');\"",
    "test:hfrf:usb": "node -e \"const manager = require('./src/services/huawei-usb-manager'); console.log('✅ Huawei USB Manager test passed');\"",
    "test:hfrf:sdr": "cd hfrf-universal-sdr && cargo check",
    "hfrf:init-db": "sqlite3 audit/sqlite/enhanced-audit.db \".read audit/sqlite/enhanced-audit-schema.sql\"",
    "hfrf:migrate": "node -e \"const service = require('./src/services/enhanced-audit-service'); service.migrateHFRFData(process.argv[1])\"",
    "hfrf:cleanup": "node -e \"const service = require('./src/services/enhanced-audit-service'); service.cleanup()\""
  },
  "keywords": [
    "self-healing",
    "multi-target-deployment",
    "github-pages",
    "firebase-hosting",
    "webtrit-swipe",
    "auditierbar",
    "onairmultimedia",
    "sdr",
    "rust",
    "sqlite",
    "huawei",
    "usb",
    "ed25519",
    "hfrf"
  ],
  "author": "Raymond Demitrio Dr. Tel",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "cheerio": "^1.0.0-rc.12",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "firebase-tools": "^13.0.0",
    "gh-pages": "^6.1.0",
    "globby": "^14.0.0",
    "jscpd": "^3.5.0",
    "prettier": "^3.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.2",
    "express": "^4.18.2",
    "firebase": "^10.7.0",
    "socket.io": "^4.6.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ViewunitySystem/OnAirMulTiMedia.git"
  },
  "bugs": {
    "url": "https://github.com/ViewunitySystem/OnAirMulTiMedia/issues"
  },
  "homepage": "https://viewunitysystem.github.io/OnAirMulTiMedia/"
}
