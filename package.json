{
  "name": "onairmultimedia",
  "version": "1.0.0",
  "description": "OnAirMulTiMedia - Universal SDR Communication Platform by Raymond Demitrio Dr. Tel",
  "main": "index.js",
  "scripts": {
    "dev": "serve -s . -p 8080",
    "build": "npm run build:css && npm run build:js",
    "build:css": "postcss src/css/main.css -o dist/css/main.css",
    "build:js": "rollup -c rollup.config.js",
    "build:production": "npm run build && npm run minify",
    "minify": "terser dist/js/main.js -o dist/js/main.min.js",
    "serve": "serve -s . -p 8080",
    "start": "npm run dev",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config jest.config.js",
    "test:integration": "playwright test",
    "test:e2e": "cypress run",
    "test:e2e:staging": "cypress run --env configFile=staging",
    "test:e2e:production": "cypress run --env configFile=production",
    "test:a11y": "axe-cli --config axe.config.js",
    "test:axe": "axe-cli",
    "test:i18n": "i18next-scanner --config i18next-scanner.config.js",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ --ext .js,.ts,.jsx,.tsx",
    "lint:fix": "eslint src/ --ext .js,.ts,.jsx,.tsx --fix",
    "format": "prettier --write src/",
    "security:scan": "npm audit && snyk test",
    "perf:budget": "lighthouse-ci autorun --budgetPath=lighthouse-budget.json",
    "i18n:check": "i18next-scanner --config i18next-scanner.config.js --check",
    "i18n:validate": "i18next-scanner --config i18next-scanner.config.js --validate",
    "monitor:deploy": "node scripts/monitor-deploy.js",
    "docs:build": "mkdocs build",
    "docs:serve": "mkdocs serve",
    "docker:build": "docker build -t onairmultimedia .",
    "docker:run": "docker run -p 8080:80 onairmultimedia",
    "docker:compose": "docker-compose up -d"
  },
  "keywords": [
    "sdr",
    "software-defined-radio",
    "amateur-radio",
    "communication",
    "internationalization",
    "multimedia",
    "canvas",
    "webrtc",
    "audio",
    "video",
    "real-time",
    "universal",
    "cross-platform",
    "responsive",
    "accessibility",
    "progressive-web-app",
    "hackrf",
    "limesdr",
    "rtl-sdr",
    "dd5be",
    "raymond-demitrio-dr-tel",
    "onairmultimedia"
  ],
  "author": {
    "name": "Raymond Demitrio Dr. Tel",
    "email": "gentlyoverdone@outlook.com",
    "url": "https://tel1.jouwweb.nl/servicesoftware",
    "callsign": "DD5BE",
    "github": "https://github.com/ViewunitySystem"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ViewunitySystem/OnAirMulTiMedia.git",
    "directory": "hfrf-universal-sdr"
  },
  "bugs": {
    "url": "https://github.com/ViewunitySystem/OnAirMulTiMedia/issues",
    "email": "gentlyoverdone@outlook.com"
  },
  "homepage": "https://tel1.jouwweb.nl/servicesoftware",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "devDependencies": {
    "@axe-core/cli": "^4.8.0",
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.0",
    "autoprefixer": "^10.4.0",
    "cypress": "^13.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-accessibility": "^1.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "i18next-scanner": "^3.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse-ci": "^0.12.0",
    "postcss": "^8.4.0",
    "postcss-cli": "^10.1.0",
    "prettier": "^3.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-terser": "^7.0.0",
    "serve": "^14.2.0",
    "snyk": "^1.1200.0",
    "terser": "^5.24.0"
  },
  "dependencies": {
    "i18next": "^23.7.0",
    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-http-backend": "^2.4.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/src/test/setup.js"],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}",
      "!src/test/**/*"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "prettier"
    ],
    "plugins": [
      "accessibility",
      "jsx-a11y"
    ],
    "env": {
      "browser": true,
      "es2021": true,
      "node": true,
      "jest": true
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "accessibility/alt-text": "error",
      "accessibility/aria-role": "error",
      "accessibility/aria-unsupported-elements": "error",
      "accessibility/click-events-have-key-events": "error",
      "accessibility/form-control-has-label": "error",
      "accessibility/heading-has-content": "error",
      "accessibility/img-redundant-alt": "error",
      "accessibility/interactive-supports-focus": "error",
      "accessivity/label-has-associated-control": "error",
      "accessibility/media-has-caption": "error",
      "accessibility/mouse-events-have-key-events": "error",
      "accessibility/no-access-key": "error",
      "accessibility/no-autofocus": "error",
      "accessibility/no-distracting-elements": "error",
      "accessibility/no-redundant-roles": "error",
      "accessibility/role-has-required-aria-props": "error",
      "accessibility/role-supports-aria-props": "error",
      "accessibility/scope": "error",
      "accessibility/tabindex-no-positive": "error"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false
  },
  "lighthouse": {
    "budget": [
      {
        "resourceSizes": [
          {
            "resourceType": "script",
            "budget": 500
          },
          {
            "resourceType": "total",
            "budget": 1000
          }
        ],
        "resourceCounts": [
          {
            "resourceType": "third-party",
            "budget": 5
          }
        ],
        "timings": [
          {
            "metric": "first-contentful-paint",
            "budget": 3000
          },
          {
            "metric": "largest-contentful-paint",
            "budget": 4000
          }
        ]
      }
    ]
  },
  "snyk": true,
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ViewunitySystem"
  },
  "contributors": [
    {
      "name": "Raymond Demitrio Dr. Tel",
      "email": "gentlyoverdone@outlook.com",
      "callsign": "DD5BE",
      "github": "https://github.com/ViewunitySystem"
    }
  ],
  "maintainers": [
    {
      "name": "Raymond Demitrio Dr. Tel",
      "email": "gentlyoverdone@outlook.com",
      "callsign": "DD5BE",
      "github": "https://github.com/ViewunitySystem"
    }
  ]
}
