# OAMTM Cloud SQL Environment Variables
# Kopiere diese Datei zu .env und fülle die Werte aus

# Cloud SQL Verbindung
DB_HOST=34.65.123.456
DB_PORT=3306
DB_USER=oamtm_user
DB_PASSWORD=secure_password
DB_NAME=oamtm_audit

# SSL-Zertifikate (Pfade zu den Dateien)
DB_SSL_CA=path/to/server-ca.pem
DB_SSL_CERT=path/to/client-cert.pem
DB_SSL_KEY=path/to/client-key.pem

# Firebase
FIREBASE_PROJECT_ID=tel1nl
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tel1nl.iam.gserviceaccount.com

# Optional: Logging
LOG_LEVEL=info
DEBUG=false
