                "dopplerShift": { "type": "number" },
                "signalStrength": { "type": "number", "minimum": 0, "maximum": 1 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "rules": [
      "Frequency must be between 18kHz and 22kHz",
      "Amplitude must be negative (dB)",
      "Signal strength must be between 0 and 1",
      "Confidence must be between 0 and 1",
      "Timestamp must be ISO 8601 format",
      "Session ID must be unique per session",
      "Device ID must be unique per device"
    ]
