{
    "name": "auto-problem-fixer-system",
    "version": "1.0.0",
    "description": "Automatic Terminal Problem Sector Fixer System - Online and Local Detection & Auto-Fix",
    "main": "scripts/auto-problem-fixer.js",
    "scripts": {
        "fix": "node scripts/auto-problem-fixer.js",
        "fix:watch": "node scripts/auto-problem-fixer.js --watch",
        "fix:online": "node scripts/auto-problem-fixer.js --online",
        "fix:dry-run": "node scripts/auto-problem-fixer.js --dry-run",
        "fix:verbose": "node scripts/auto-problem-fixer.js --verbose",
        "fix:start": "node scripts/auto-problem-fixer.js --start",
        "fix:stop": "node scripts/auto-problem-fixer.js --stop",
        "fix:status": "node scripts/auto-problem-fixer.js --status",
        "fix:bash": "bash scripts/auto-problem-fixer.sh",
        "fix:bash:start": "bash scripts/auto-problem-fixer.sh --start",
        "fix:bash:stop": "bash scripts/auto-problem-fixer.sh --stop",
        "fix:bash:status": "bash scripts/auto-problem-fixer.sh --status",
        "fix:bash:watch": "bash scripts/auto-problem-fixer.sh --watch",
        "fix:powershell": "powershell -ExecutionPolicy Bypass -File scripts/auto-problem-fixer.ps1",
        "fix:powershell:start": "powershell -ExecutionPolicy Bypass -File scripts/auto-problem-fixer.ps1 -Start",
        "fix:powershell:stop": "powershell -ExecutionPolicy Bypass -File scripts/auto-problem-fixer.ps1 -Stop",
        "fix:powershell:status": "powershell -ExecutionPolicy Bypass -File scripts/auto-problem-fixer.ps1 -Status",
        "fix:powershell:watch": "powershell -ExecutionPolicy Bypass -File scripts/auto-problem-fixer.ps1 -Watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "auto-fix",
        "github-actions",
        "workflow",
        "linting",
        "vscode",
        "terminal",
        "monitoring",
        "problem-detection"
    ],
    "author": "Raymond Demitrio Dr. Tel",
    "license": "MIT",
    "dependencies": {
        "chalk": "^4.1.2"
    },
    "devDependencies": {
        "eslint": "^8.0.0",
        "prettier": "^2.8.0",
        "typescript": "^5.0.0"
    },
    "engines": {
        "node": ">=16.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/your-username/your-repo.git"
    },
    "bugs": {
        "url": "https://github.com/your-username/your-repo/issues"
    },
    "homepage": "https://github.com/your-username/your-repo#readme"
}