<svg width="64" height="64" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="iconGradient" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#7dd3fc;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f472b6;stop-opacity:1" />
    </radialGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
      <feMerge> 
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Hauptkreis -->
  <circle cx="32" cy="32" r="28" fill="url(#iconGradient)" filter="url(#glow)"/>
  
  <!-- Innere Struktur -->
  <circle cx="32" cy="32" r="20" fill="none" stroke="#001020" stroke-width="2" opacity="0.3"/>
  <circle cx="32" cy="32" r="12" fill="none" stroke="#001020" stroke-width="1" opacity="0.5"/>
  
  <!-- Zentrale Punkte -->
  <circle cx="32" cy="32" r="4" fill="#001020"/>
  <circle cx="32" cy="32" r="2" fill="#7dd3fc"/>
  
  <!-- Strahlen -->
  <g stroke="#001020" stroke-width="2" opacity="0.4">
    <line x1="32" y1="4" x2="32" y2="12"/>
    <line x1="32" y1="52" x2="32" y2="60"/>
    <line x1="4" y1="32" x2="12" y2="32"/>
    <line x1="52" y1="32" x2="60" y2="32"/>
    <line x1="8" y1="8" x2="14" y2="14"/>
    <line x1="50" y1="50" x2="56" y2="56"/>
    <line x1="56" y1="8" x2="50" y2="14"/>
    <line x1="8" y1="56" x2="14" y2="50"/>
  </g>
</svg>
