diff --git a/governance/meta-reflector.mjs b/governance/meta-reflector.mjs
new file mode 100644
index 0000000..1234567
--- /dev/null
+++ b/governance/meta-reflector.mjs
@@ -0,0 +1,45 @@
+// Meta-Reflector: Systemdiagnose & Status-Audit alle 30 Minuten
+// Governance-Version für Legal/Compliance-Teams
+
+import { readFile, writeFile, appendFile } from 'node:fs/promises';
+
+function safe(s) { 
+  try { return JSON.parse(s) } 
+  catch { return null } 
+}
+
+const cfg = safe(await readFile('config/self-awareness.json', 'utf8'));
+const ucmTxt = await readFile(cfg.signals.ucm, 'utf8').catch(() => '');
+const fixesTxt = await readFile(cfg.signals.fixes, 'utf8').catch(() => '');
+
+const evs = ucmTxt.split('\n').filter(Boolean).map(l => safe(l)).filter(Boolean);
+const fixed = new Set(fixesTxt.split('\n').filter(Boolean).map(l => safe(l)).filter(Boolean).map(f => `${f.rule}:${f.page || ''}`));
+
+const graph = [];
+for (const ev of evs) {
+  const m = ev.msg || '';
+  const k = /CSP/i.test(m) ? 'recover:csp' : 
+            /404|Not Found/i.test(m) ? 'recover:404' : 
+            /locked|SQLITE_BUSY/i.test(m) ? 'pragma:sqlite_wal' : 'observe';
+  graph.push({ 
+    url: ev.meta?.url || null, 
+    suggestedRule: k, 
+    alreadyFixed: fixed.has(`${k}:${ev.meta?.url || ''}`) 
+  });
+}
+
+await writeFile('audit/meta-reflection.json', JSON.stringify({ 
+  ts: new Date().toISOString(), 
+  graph 
+}, null, 2));
+
+await appendFile('audit/fixes.jsonl', JSON.stringify({ 
+  ts: new Date().toISOString(), 
+  rule: 'meta-reflect', 
+  detail: { count: graph.length } 
+}) + '\n');
+
+console.log('[meta-reflector] governance analysis complete');

