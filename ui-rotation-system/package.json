{
  "name": "sdr-ui-rotation-system",
  "version": "1.0.0",
  "description": "Produktionsreife UI/UX-Rotations-App für SDR-Dashboard mit Live-Status und Theme-Switching",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "echo 'Server build completed'",
    "test": "vitest",
    "lint": "eslint . --ext .js,.ts,.jsx,.tsx",
    "format": "prettier --write .",
    "docker:build": "docker build -t sdr-ui-rotation .",
    "docker:run": "docker run -p 3000:3000 sdr-ui-rotation"
  },
  "keywords": [
    "sdr",
    "ui-rotation",
    "theme-switching",
    "realtime",
    "dashboard",
    "websocket",
    "api"
  ],
  "author": "Raymond Demitrio Dr. Tel",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "uuid": "^9.0.1",
    "node-cron": "^3.0.3",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "vite": "^5.0.10",
    "@vitejs/plugin-react": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.7",
    "@types/node-cron": "^3.0.11",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
