{
  "id": "global_meeting_clock",
  "name": "Global Meeting Clock",
  "version": "1.0.0",
  "description": "Ein globaler Meeting-Clock für internationale Zusammenarbeit mit Zeitzonen-Anzeige",
  "type": "meeting",
  "components": [
    {
      "id": "clock-display",
      "type": "clock",
      "config": {
        "timezones": [
          { "name": "UTC", "offset": 0 },
          { "name": "CET", "offset": 1 },
          { "name": "EST", "offset": -5 },
          { "name": "PST", "offset": -8 },
          { "name": "JST", "offset": 9 }
        ],
        "format": "24h",
        "showSeconds": true
      }
    },
    {
      "id": "meeting-timer",
      "type": "timer",
      "config": {
        "duration": 60,
        "warningTime": 10,
        "autoStart": false
      }
    },
    {
      "id": "participant-list",
      "type": "participants",
      "config": {
        "maxParticipants": 50,
        "showStatus": true,
        "showTimeZone": true
      }
    }
  ],
  "settings": {
    "autoStart": false,
    "recording": true,
    "quality": "high"
  },
  "createdAt": "2024-01-15T10:00:00Z",
  "updatedAt": "2024-01-15T10:00:00Z"
}