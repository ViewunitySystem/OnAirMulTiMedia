name: Tree Monitoring & Health Checks

on:
  push:
    branches: [ main, mainzero, develop ]
  pull_request:
    branches: [ main, mainzero ]
  schedule:
    # Run every 15 minutes
    - cron: '*/15 * * * *'
  workflow_dispatch:
    inputs:
      scan_type:
        description: 'Type of scan to perform'
        required: true
        default: 'full'
        type: choice
        options:
        - full
        - urls
        - health
        - learning

env:
  NODE_VERSION: '20'
  MONITORING_INTERVAL: 30000
  URL_TEST_INTERVAL: 60000
  HEALTH_CHECK_INTERVAL: 120000

jobs:
  tree-monitoring:
    name: Tree Monitoring & Analysis
    runs-on: ubuntu-latest
    timeout-minutes: 30
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4
      with:
        fetch-depth: 0
        
    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: ${{ env.NODE_VERSION }}
        cache: 'npm'
        
    - name: Install dependencies
      run: npm ci
      
    - name: Install monitoring dependencies
      run: |
        npm install dsp.js --save-dev
        npm install tsx --save-dev
        
    - name: Create monitoring directory
      run: mkdir -p monitoring logs
      
    - name: Run Tree Monitor
      run: |
        echo "Starting Tree Monitor..."
        npm run tree-monitor &
        MONITOR_PID=$!
        
        # Run for 5 minutes to collect data
        sleep 300
        
        # Stop the monitor
        kill $MONITOR_PID 2>/dev/null || true
        
        # Wait a moment for cleanup
        sleep 5
        
      env:
        GITHUB_REPOSITORY: ${{ github.repository }}
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        
    - name: Generate Monitoring Report
      run: |
        echo "Generating monitoring report..."
        npm run monitoring-report
        
    - name: Upload monitoring artifacts
      uses: actions/upload-artifact@v4
      with:
        name: monitoring-report-${{ github.run_number }}
        path: |
          monitoring/
          logs/
        retention-days: 30
        
    - name: Comment PR with monitoring results
      if: github.event_name == 'pull_request'
      uses: actions/github-script@v7
      with:
        script: |
          const fs = require('fs');
          const path = require('path');
          
          try {
            const reportPath = 'monitoring/monitoring-report.json';
            if (fs.existsSync(reportPath)) {
              const report = JSON.parse(fs.readFileSync(reportPath, 'utf8'));
              
              const comment = `## 🌳 Tree Monitoring Results
              
              **Scan Type:** ${{ github.event.inputs.scan_type || 'full' }}
              **Timestamp:** ${report.timestamp}
              **Session ID:** ${report.sessionId}
              
              ### 📊 Summary
              - **Total Tests:** ${report.summary.totalTests}
              - **Error Rate:** ${report.summary.errorRate}%
              - **Availability:** ${report.summary.availability}%
              - **Avg Response Time:** ${report.summary.avgResponseTime}ms
              
              ### 🏥 Health Status
              - **Healthy:** ${report.summary.healthSummary.healthy}
              - **Warnings:** ${report.summary.healthSummary.warning}
              - **Critical:** ${report.summary.healthSummary.critical}
              
              ### 🔍 Issues Found
              ${report.recommendations.length > 0 ? 
                report.recommendations.map(rec => `- ${rec}`).join('\n') : 
                'No issues detected'
              }
              
              ### 📈 Learning Patterns
              ${report.learningPatterns.length > 0 ? 
                report.learningPatterns.map(p => `- **${p.pattern}**: ${p.frequency} occurrences, confidence: ${p.confidence}`).join('\n') : 
                'No learning patterns detected'
              }
              
              ---
              *Generated by Tree Monitor - Comprehensive monitoring system for entire tree with learning factor*
              `;
              
              github.rest.issues.createComment({
                issue_number: context.issue.number,
                owner: context.repo.owner,
                repo: context.repo.repo,
                body: comment
              });
            }
          } catch (error) {
            console.error('Failed to comment PR:', error);
          }

  url-testing:
    name: URL Testing & 404 Detection
    runs-on: ubuntu-latest
    timeout-minutes: 15
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4
      
    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: ${{ env.NODE_VERSION }}
        cache: 'npm'
        
    - name: Install dependencies
      run: npm ci
      
    - name: Discover URLs
      id: discover-urls
      run: |
        echo "Discovering URLs to test..."
        
        # Find HTML files and convert to URLs
        BASE_URL="https://viewunitysystem.github.io/OnAirMulTiMedia"
        URLS="$BASE_URL/"
        
        # Add main documentation URLs
        URLS="$URLS $BASE_URL/docs/"
        URLS="$URLS $BASE_URL/docs/monitoring-dashboard.html"
        URLS="$URLS $BASE_URL/docs/change-log.html"
        URLS="$URLS $BASE_URL/docs/tool-map.html"
        URLS="$URLS $BASE_URL/docs/consent-ui.html"
        URLS="$URLS $BASE_URL/docs/android-launcher.html"
        URLS="$URLS $BASE_URL/docs/ultrasound-dashboard.html"
        URLS="$URLS $BASE_URL/docs/mission-plan.html"
        URLS="$URLS $BASE_URL/docs/mission-visualizer.html"
        
        # Add script URLs
        URLS="$URLS $BASE_URL/scripts/"
        
        # Find all HTML files
        find . -name "*.html" -type f | while read file; do
          url_path=$(echo "$file" | sed 's|^\./||' | sed 's| |%20|g')
          URLS="$URLS $BASE_URL/$url_path"
        done
        
        echo "urls=$URLS" >> $GITHUB_OUTPUT
        echo "Discovered URLs:"
        echo "$URLS" | tr ' ' '\n' | sort -u
        
    - name: Test URLs
      run: |
        echo "Testing URLs for 404 errors and response times..."
        
        # Create results file
        echo '{"timestamp":"'$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)'","tests":[]}' > url-test-results.json
        
        # Test each URL
        for url in ${{ steps.discover-urls.outputs.urls }}; do
          echo "Testing: $url"
          
          start_time=$(date +%s%3N)
          
          # Test URL with timeout
          response=$(curl -s -w "%{http_code},%{time_total},%{size_download}" -o /dev/null --max-time 30 "$url" 2>/dev/null || echo "000,30.000,0")
          
          end_time=$(date +%s%3N)
          response_time=$((end_time - start_time))
          
          # Parse response
          http_code=$(echo "$response" | cut -d',' -f1)
          time_total=$(echo "$response" | cut -d',' -f2)
          size_download=$(echo "$response" | cut -d',' -f3)
          
          # Determine status
          if [ "$http_code" = "200" ]; then
            status="success"
          elif [ "$http_code" = "404" ]; then
            status="not_found"
          elif [ "$http_code" = "000" ]; then
            status="timeout"
          else
            status="error"
          fi
          
          # Add to results
          jq --arg url "$url" \
             --arg status "$status" \
             --arg http_code "$http_code" \
             --arg response_time "$response_time" \
             --arg time_total "$time_total" \
             --arg size_download "$size_download" \
             '.tests += [{
               "url": $url,
               "status": $status,
               "http_code": ($http_code | tonumber),
               "response_time": ($response_time | tonumber),
               "time_total": ($time_total | tonumber),
               "size_download": ($size_download | tonumber),
               "timestamp": "'$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)'"
             }]' url-test-results.json > url-test-results.tmp && mv url-test-results.tmp url-test-results.json
          
          echo "  Status: $status ($http_code), Time: ${time_total}s, Size: ${size_download} bytes"
        done
        
        echo "URL testing completed"
        
    - name: Analyze Results
      run: |
        echo "Analyzing URL test results..."
        
        # Calculate statistics
        total_tests=$(jq '.tests | length' url-test-results.json)
        success_tests=$(jq '[.tests[] | select(.status == "success")] | length' url-test-results.json)
        not_found_tests=$(jq '[.tests[] | select(.status == "not_found")] | length' url-test-results.json)
        error_tests=$(jq '[.tests[] | select(.status == "error" or .status == "timeout")] | length' url-test-results.json)
        
        # Calculate averages
        avg_response_time=$(jq '[.tests[] | .response_time] | add / length' url-test-results.json)
        avg_time_total=$(jq '[.tests[] | .time_total] | add / length' url-test-results.json)
        
        # Calculate percentages
        success_rate=$((success_tests * 100 / total_tests))
        error_rate=$((error_tests * 100 / total_tests))
        not_found_rate=$((not_found_tests * 100 / total_tests))
        
        echo "## URL Test Results" >> url-test-summary.md
        echo "" >> url-test-summary.md
        echo "**Total Tests:** $total_tests" >> url-test-summary.md
        echo "**Success Rate:** $success_rate%" >> url-test-summary.md
        echo "**Error Rate:** $error_rate%" >> url-test-summary.md
        echo "**404 Rate:** $not_found_rate%" >> url-test-summary.md
        echo "**Avg Response Time:** $(printf "%.2f" $avg_response_time)ms" >> url-test-summary.md
        echo "**Avg Time Total:** $(printf "%.2f" $avg_time_total)s" >> url-test-summary.md
        echo "" >> url-test-summary.md
        
        # List 404 errors
        if [ "$not_found_tests" -gt 0 ]; then
          echo "### 🚨 404 Errors Found:" >> url-test-summary.md
          echo "" >> url-test-summary.md
          jq -r '.tests[] | select(.status == "not_found") | "- " + .url' url-test-results.json >> url-test-summary.md
          echo "" >> url-test-summary.md
        fi
        
        # List other errors
        if [ "$error_tests" -gt 0 ]; then
          echo "### ⚠️ Other Errors Found:" >> url-test-summary.md
          echo "" >> url-test-summary.md
          jq -r '.tests[] | select(.status == "error" or .status == "timeout") | "- " + .url + " (" + .status + ")"' url-test-results.json >> url-test-summary.md
          echo "" >> url-test-summary.md
        fi
        
        # List slow responses
        slow_tests=$(jq '[.tests[] | select(.response_time > 2000)] | length' url-test-results.json)
        if [ "$slow_tests" -gt 0 ]; then
          echo "### 🐌 Slow Responses (>2s):" >> url-test-summary.md
          echo "" >> url-test-summary.md
          jq -r '.tests[] | select(.response_time > 2000) | "- " + .url + " (" + (.response_time | tostring) + "ms)"' url-test-results.json >> url-test-summary.md
          echo "" >> url-test-summary.md
        fi
        
        echo "Results analysis completed"
        
    - name: Upload URL test results
      uses: actions/upload-artifact@v4
      with:
        name: url-test-results-${{ github.run_number }}
        path: |
          url-test-results.json
          url-test-summary.md
        retention-days: 30
        
    - name: Comment PR with URL test results
      if: github.event_name == 'pull_request'
      uses: actions/github-script@v7
      with:
        script: |
          const fs = require('fs');
          
          try {
            if (fs.existsSync('url-test-summary.md')) {
              const summary = fs.readFileSync('url-test-summary.md', 'utf8');
              
              const comment = `## 🔗 URL Testing Results
              
              ${summary}
              
              ---
              *Generated by Tree Monitor - Comprehensive monitoring system for entire tree with learning factor*
              `;
              
              github.rest.issues.createComment({
                issue_number: context.issue.number,
                owner: context.repo.owner,
                repo: context.repo.repo,
                body: comment
              });
            }
          } catch (error) {
            console.error('Failed to comment PR with URL test results:', error);
          }

  health-checks:
    name: Health Checks & System Status
    runs-on: ubuntu-latest
    timeout-minutes: 10
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4
      
    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: ${{ env.NODE_VERSION }}
        cache: 'npm'
        
    - name: Install dependencies
      run: npm ci
      
    - name: Run Health Gates
      run: |
        echo "Running health gates..."
        npm run health-gates
        
    - name: Check System Health
      run: |
        echo "Checking system health..."
        
        # Check disk space
        df -h
        
        # Check memory usage
        free -h
        
        # Check CPU load
        uptime
        
        # Check file system
        find . -type f -name "*.json" -exec echo "Found: {}" \; | head -10
        
        # Check for common issues
        echo "Checking for common issues..."
        
        # Check for broken symlinks
        find . -type l -exec test ! -e {} \; -print | while read link; do
          echo "Broken symlink: $link"
        done
        
        # Check for empty files
        find . -type f -empty | while read file; do
          echo "Empty file: $file"
        done
        
        # Check for large files
        find . -type f -size +10M | while read file; do
          echo "Large file: $file"
        done
        
    - name: Generate Health Report
      run: |
        echo "Generating health report..."
        
        cat > health-report.md << EOF
        ## 🏥 System Health Report
        
        **Timestamp:** $(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)
        **GitHub Actions:** ${{ github.workflow }}
        **Run ID:** ${{ github.run_id }}
        
        ### 📊 System Metrics
        
        **Disk Usage:**
        \`\`\`
        $(df -h)
        \`\`\`
        
        **Memory Usage:**
        \`\`\`
        $(free -h)
        \`\`\`
        
        **System Load:**
        \`\`\`
        $(uptime)
        \`\`\`
        
        ### 🔍 File System Analysis
        
        **Total Files:** $(find . -type f | wc -l)
        **Total Directories:** $(find . -type d | wc -l)
        **Total Size:** $(du -sh . | cut -f1)
        
        **File Types:**
        \`\`\`
        $(find . -type f -name "*.*" | sed 's/.*\.//' | sort | uniq -c | sort -nr | head -10)
        \`\`\`
        
        ### 🚨 Issues Found
        
        EOF
        
        # Check for issues
        broken_symlinks=$(find . -type l -exec test ! -e {} \; -print | wc -l)
        empty_files=$(find . -type f -empty | wc -l)
        large_files=$(find . -type f -size +10M | wc -l)
        
        if [ "$broken_symlinks" -gt 0 ]; then
          echo "- **Broken Symlinks:** $broken_symlinks" >> health-report.md
        fi
        
        if [ "$empty_files" -gt 0 ]; then
          echo "- **Empty Files:** $empty_files" >> health-report.md
        fi
        
        if [ "$large_files" -gt 0 ]; then
          echo "- **Large Files (>10MB):** $large_files" >> health-report.md
        fi
        
        if [ "$broken_symlinks" -eq 0 ] && [ "$empty_files" -eq 0 ] && [ "$large_files" -eq 0 ]; then
          echo "No issues detected" >> health-report.md
        fi
        
        echo "" >> health-report.md
        echo "---" >> health-report.md
        echo "*Generated by Tree Monitor - Comprehensive monitoring system for entire tree with learning factor*" >> health-report.md
        
    - name: Upload health report
      uses: actions/upload-artifact@v4
      with:
        name: health-report-${{ github.run_number }}
        path: health-report.md
        retention-days: 30
        
    - name: Comment PR with health report
      if: github.event_name == 'pull_request'
      uses: actions/github-script@v7
      with:
        script: |
          const fs = require('fs');
          
          try {
            if (fs.existsSync('health-report.md')) {
              const report = fs.readFileSync('health-report.md', 'utf8');
              
              github.rest.issues.createComment({
                issue_number: context.issue.number,
                owner: context.repo.owner,
                repo: context.repo.repo,
                body: report
              });
            }
          } catch (error) {
            console.error('Failed to comment PR with health report:', error);
          }

  learning-analysis:
    name: Learning Analysis & Pattern Detection
    runs-on: ubuntu-latest
    timeout-minutes: 20
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4
      with:
        fetch-depth: 0
        
    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: ${{ env.NODE_VERSION }}
        cache: 'npm'
        
    - name: Install dependencies
      run: npm ci
      
    - name: Analyze Git History
      run: |
        echo "Analyzing Git history for learning patterns..."
        
        # Create learning analysis directory
        mkdir -p monitoring/learning
        
        # Analyze recent commits
        git log --oneline --since="7 days ago" > monitoring/learning/recent-commits.txt
        
        # Analyze file changes
        git log --name-status --since="7 days ago" > monitoring/learning/file-changes.txt
        
        # Analyze commit patterns
        git log --pretty=format:"%h %ad %s" --date=short --since="30 days ago" > monitoring/learning/commit-patterns.txt
        
        # Count changes by file type
        git log --name-only --since="30 days ago" | grep -E '\.(js|ts|html|css|json|md)$' | sort | uniq -c | sort -nr > monitoring/learning/file-frequency.txt
        
        echo "Git history analysis completed"
        
    - name: Analyze Change Patterns
      run: |
        echo "Analyzing change patterns..."
        
        # Analyze common change types
        cat > monitoring/learning/pattern-analysis.json << EOF
        {
          "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)",
          "analysis_period": "30_days",
          "patterns": []
        }
        EOF
        
        # Extract patterns from git log
        git log --name-status --since="30 days ago" | while read line; do
          if [[ $line =~ ^[AMD] ]]; then
            action=$(echo $line | cut -c1)
            file=$(echo $line | cut -c2-)
            extension="${file##*.}"
            
            echo "Pattern: $action:$extension:$file"
          fi
        done | sort | uniq -c | sort -nr > monitoring/learning/change-patterns.txt
        
        # Analyze error patterns
        if [ -f "monitoring/url-test-results.json" ]; then
          jq '[.tests[] | select(.status != "success") | .status] | group_by(.) | map({status: .[0], count: length})' monitoring/url-test-results.json > monitoring/learning/error-patterns.json
        fi
        
        echo "Change pattern analysis completed"
        
    - name: Generate Learning Report
      run: |
        echo "Generating learning report..."
        
        cat > monitoring/learning/learning-report.md << EOF
        ## 🧠 Learning Analysis Report
        
        **Timestamp:** $(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)
        **Analysis Period:** 30 days
        **Repository:** ${{ github.repository }}
        
        ### 📈 Change Patterns
        
        **Most Frequently Changed Files:**
        \`\`\`
        $(head -20 monitoring/learning/file-frequency.txt)
        \`\`\`
        
        **Change Patterns:**
        \`\`\`
        $(head -20 monitoring/learning/change-patterns.txt)
        \`\`\`
        
        ### 🔍 Insights
        
        EOF
        
        # Generate insights
        total_changes=$(wc -l < monitoring/learning/change-patterns.txt)
        most_changed_file=$(head -1 monitoring/learning/file-frequency.txt | awk '{print $2}')
        most_common_action=$(head -1 monitoring/learning/change-patterns.txt | awk '{print $2}' | cut -d: -f1)
        
        echo "- **Total Change Patterns:** $total_changes" >> monitoring/learning/learning-report.md
        echo "- **Most Changed File:** $most_changed_file" >> monitoring/learning/learning-report.md
        echo "- **Most Common Action:** $most_common_action" >> monitoring/learning/learning-report.md
        echo "" >> monitoring/learning/learning-report.md
        
        # Add recommendations
        echo "### 💡 Recommendations" >> monitoring/learning/learning-report.md
        echo "" >> monitoring/learning/learning-report.md
        
        if [ -f "monitoring/learning/error-patterns.json" ]; then
          echo "**Error Patterns:**" >> monitoring/learning/learning-report.md
          jq -r '.[] | "- " + .status + ": " + (.count | tostring) + " occurrences"' monitoring/learning/error-patterns.json >> monitoring/learning/learning-report.md
          echo "" >> monitoring/learning/learning-report.md
        fi
        
        echo "- Monitor frequently changed files for potential issues" >> monitoring/learning/learning-report.md
        echo "- Implement automated testing for common change patterns" >> monitoring/learning/learning-report.md
        echo "- Set up alerts for unusual change frequencies" >> monitoring/learning/learning-report.md
        echo "" >> monitoring/learning/learning-report.md
        
        echo "---" >> monitoring/learning/learning-report.md
        echo "*Generated by Tree Monitor - Comprehensive monitoring system for entire tree with learning factor*" >> monitoring/learning/learning-report.md
        
    - name: Upload learning analysis
      uses: actions/upload-artifact@v4
      with:
        name: learning-analysis-${{ github.run_number }}
        path: monitoring/learning/
        retention-days: 30
        
    - name: Comment PR with learning analysis
      if: github.event_name == 'pull_request'
      uses: actions/github-script@v7
      with:
        script: |
          const fs = require('fs');
          
          try {
            if (fs.existsSync('monitoring/learning/learning-report.md')) {
              const report = fs.readFileSync('monitoring/learning/learning-report.md', 'utf8');
              
              github.rest.issues.createComment({
                issue_number: context.issue.number,
                owner: context.repo.owner,
                repo: context.repo.repo,
                body: report
              });
            }
          } catch (error) {
            console.error('Failed to comment PR with learning analysis:', error);
          }

  summary:
    name: Monitoring Summary
    runs-on: ubuntu-latest
    needs: [tree-monitoring, url-testing, health-checks, learning-analysis]
    if: always()
    
    steps:
    - name: Download all artifacts
      uses: actions/download-artifact@v4
      
    - name: Generate Summary Report
      run: |
        echo "Generating comprehensive monitoring summary..."
        
        cat > monitoring-summary.md << EOF
        ## 🌳 Tree Monitoring Summary
        
        **Workflow:** ${{ github.workflow }}
        **Run ID:** ${{ github.run_id }}
        **Timestamp:** $(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)
        **Repository:** ${{ github.repository }}
        **Branch:** ${{ github.ref_name }}
        **Commit:** ${{ github.sha }}
        
        ### 📊 Job Status
        
        - **Tree Monitoring:** ${{ needs.tree-monitoring.result }}
        - **URL Testing:** ${{ needs.url-testing.result }}
        - **Health Checks:** ${{ needs.health-checks.result }}
        - **Learning Analysis:** ${{ needs.learning-analysis.result }}
        
        ### 🔗 GitHub Actions
        
        **Workflow URL:** https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}
        **Repository:** https://github.com/${{ github.repository }}
        
        ### 📈 Key Metrics
        
        EOF
        
        # Add metrics from artifacts if available
        if [ -f "monitoring-report-${{ github.run_number }}/monitoring-report.json" ]; then
          echo "**Monitoring Report Available:** ✅" >> monitoring-summary.md
        else
          echo "**Monitoring Report Available:** ❌" >> monitoring-summary.md
        fi
        
        if [ -f "url-test-results-${{ github.run_number }}/url-test-results.json" ]; then
          echo "**URL Test Results Available:** ✅" >> monitoring-summary.md
        else
          echo "**URL Test Results Available:** ❌" >> monitoring-summary.md
        fi
        
        if [ -f "health-report-${{ github.run_number }}/health-report.md" ]; then
          echo "**Health Report Available:** ✅" >> monitoring-summary.md
        else
          echo "**Health Report Available:** ❌" >> monitoring-summary.md
        fi
        
        if [ -f "learning-analysis-${{ github.run_number }}/learning-report.md" ]; then
          echo "**Learning Analysis Available:** ✅" >> monitoring-summary.md
        else
          echo "**Learning Analysis Available:** ❌" >> monitoring-summary.md
        fi
        
        echo "" >> monitoring-summary.md
        echo "### 🎯 Next Steps" >> monitoring-summary.md
        echo "" >> monitoring-summary.md
        echo "- Review all generated reports" >> monitoring-summary.md
        echo "- Address any 404 errors found" >> monitoring-summary.md
        echo "- Fix critical health issues" >> monitoring-summary.md
        echo "- Implement recommendations from learning analysis" >> monitoring-summary.md
        echo "" >> monitoring-summary.md
        echo "---" >> monitoring-summary.md
        echo "*Generated by Tree Monitor - Comprehensive monitoring system for entire tree with learning factor*" >> monitoring-summary.md
        
    - name: Upload summary report
      uses: actions/upload-artifact@v4
      with:
        name: monitoring-summary-${{ github.run_number }}
        path: monitoring-summary.md
        retention-days: 30
        
    - name: Comment PR with summary
      if: github.event_name == 'pull_request'
      uses: actions/github-script@v7
      with:
        script: |
          const fs = require('fs');
          
          try {
            if (fs.existsSync('monitoring-summary.md')) {
              const summary = fs.readFileSync('monitoring-summary.md', 'utf8');
              
              github.rest.issues.createComment({
                issue_number: context.issue.number,
                owner: context.repo.owner,
                repo: context.repo.repo,
                body: summary
              });
            }
          } catch (error) {
            console.error('Failed to comment PR with summary:', error);
          }
