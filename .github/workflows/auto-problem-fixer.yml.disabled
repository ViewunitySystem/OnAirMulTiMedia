name: Auto Problem Fixer - Online Mode

on:
  push:
    branches: [ main, develop, gh-pages ]
  pull_request:
    branches: [ main, develop ]
  schedule:
    # Run automatic fixes daily at 3 AM UTC
    - cron: '0 3 * * *'
  workflow_dispatch:
    inputs:
      mode:
        description: 'Fix mode'
        required: false
        default: 'auto'
        type: choice
        options:
        - auto
        - dry-run
        - verbose

env:
  NODE_VERSION: '20'
  AUTO_FIX_MODE: ${{ github.event.inputs.mode || 'auto' }}

jobs:
  auto-fix:
    name: Auto Problem Fixer
    runs-on: ubuntu-latest
    timeout-minutes: 10
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'
          
      - name: Install dependencies
        run: |
          npm install -g chalk
          npm install
          
      - name: Run Auto Problem Fixer
        run: |
          node scripts/auto-problem-fixer.js --online --verbose
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          AUTO_FIX_MODE: ${{ env.AUTO_FIX_MODE }}
          
      - name: Check for changes
        id: changes
        run: |
          if [ -n "$(git status --porcelain)" ]; then
            echo "changes=true" >> $GITHUB_OUTPUT
            echo "📝 Changes detected - committing fixes"
          else
            echo "changes=false" >> $GITHUB_OUTPUT
            echo "✅ No changes needed"
          fi
          
      - name: Commit fixes
        if: steps.changes.outputs.changes == 'true'
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "GitHub Action"
          git add .
          git commit -m "🤖 Auto-fix: Applied automatic problem fixes

          - Fixed GitHub Actions workflow issues
          - Updated VS Code configuration
          - Applied linting fixes
          - Resolved secret validation warnings
          
          Generated by Auto Problem Fixer System v1.0.0"
          
      - name: Push changes
        if: steps.changes.outputs.changes == 'true'
        run: |
          git push
          
      - name: Upload fix report
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: auto-fix-report
          path: auto-fix-report.json
          retention-days: 30
          
      - name: Comment on PR
        if: github.event_name == 'pull_request' && steps.changes.outputs.changes == 'true'
        uses: actions/github-script@v7
        with:
          script: |
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: `🤖 **Auto Problem Fixer Results**
              
              ✅ **Fixes Applied Successfully**
              
              The Auto Problem Fixer System has automatically resolved the following issues:
              - GitHub Actions workflow validation errors
              - VS Code extension warning suppression
              - Linting and formatting issues
              - Secret validation warnings
              
              📊 **Report**: Check the artifacts for detailed fix report
              🔄 **Status**: All problems resolved automatically
              
              *Generated by Auto Problem Fixer System v1.0.0*`
            })

  notify:
    name: Notify Results
    runs-on: ubuntu-latest
    needs: auto-fix
    if: always()
    
    steps:
      - name: Download fix report
        uses: actions/download-artifact@v4
        with:
          name: auto-fix-report
          
      - name: Parse report
        id: report
        run: |
          if [ -f "auto-fix-report.json" ]; then
            REPORT=$(cat auto-fix-report.json)
            TOTAL_FIXES=$(echo "$REPORT" | jq '.summary.totalFixes')
            TOTAL_ERRORS=$(echo "$REPORT" | jq '.summary.totalErrors')
            SUCCESS_RATE=$(echo "$REPORT" | jq '.summary.successRate')
            
            echo "total_fixes=$TOTAL_FIXES" >> $GITHUB_OUTPUT
            echo "total_errors=$TOTAL_ERRORS" >> $GITHUB_OUTPUT
            echo "success_rate=$SUCCESS_RATE" >> $GITHUB_OUTPUT
          else
            echo "total_fixes=0" >> $GITHUB_OUTPUT
            echo "total_errors=0" >> $GITHUB_OUTPUT
            echo "success_rate=0" >> $GITHUB_OUTPUT
          fi
          
      - name: Send notification
        if: env.SLACK_WEBHOOK != ''
        run: |
          curl -X POST -H 'Content-type: application/json' \
            --data "{\"text\":\"🤖 Auto Problem Fixer Results: ${{ steps.report.outputs.total_fixes }} fixes applied, ${{ steps.report.outputs.total_errors }} errors detected (Success rate: ${{ steps.report.outputs.success_rate }}%)\"}" \
            ${{ secrets.SLACK_WEBHOOK }}
        env:
          SLACK_WEBHOOK: ${{ secrets.SLACK_WEBHOOK }}
